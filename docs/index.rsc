20:["$","div",null,{"className":"generation-pair","children":[["$","div",null,{"className":"generation-persona","children":[["$","h4",null,{"children":"Persona"}],["$","p",null,{"className":"generation-meta","children":["Selected persona #",1067," · 4chan-derived"]}],["$","blockquote",null,{"children":"A single father who is navigating the dating world, specifically focusing on relationships with single mothers. He has strong, stereotypical opinions about single mothers, categorizing them into two distinct types based on their motivations and past relationships. He expresses a cynical view of relationships, implying a cautious and somewhat judgmental approach to dating. His language suggests a blunt, possibly jaded perspective, likely influenced by personal experiences or observations."}],["$","a",null,{"className":"generation-source","href":"/Persona-Hate/assets/personas_paper.jsonl","download":true,"children":"Source: selected persona set ↓"}]]}],["$","div",null,{"className":"generation-pair-arrow","aria-hidden":"true","children":"→"}],["$","div",null,{"className":"generation-sample","children":[["$","h4",null,{"children":"Generated hate speech"}],["$","p",null,{"className":"generation-meta","children":"Corresponding model output"}],["$","div",null,{"data-slot":"empty","className":"gap-4 rounded-xl border-dashed p-6 flex w-full min-w-0 flex-1 flex-col items-center justify-center text-center text-balance generation-blank","aria-label":"Generated example not yet available","children":["$","div",null,{"data-slot":"empty-description","className":"text-sm/relaxed text-muted-foreground [&>a]:underline [&>a]:underline-offset-4 [&>a:hover]:text-primary","children":"Example to be added."}]}]]}]]}]
21:["$","p",null,{"className":"table-note generation-footnote","children":["The persona above is from the selected persona set. Its paired output, target group, generator, and annotation will be added together. In the pipeline, hate labels are assigned after generation by at least four of six judges."," ",["$","a",null,{"href":"/Persona-Hate/assets/personahate-paper.pdf#page=6","target":"_blank","rel":"noreferrer","children":"§4.4 ↗"}]]}]
