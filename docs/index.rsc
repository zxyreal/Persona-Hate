10:["$","section",null,{"id":"overview","children":[["$","h2",null,{"children":"A pipeline built to expand"}],["$","p",null,{"children":["Generation runs in parallel across personas, target groups, and models; annotation runs in parallel across samples. Adding a generator reuses the persona pool, selection procedure, and prompt design, requiring only a new generation-and-annotation run."," ",["$","a",null,{"href":"/Persona-Hate/assets/personahate-paper.pdf#page=8","target":"_blank","rel":"noreferrer","children":"Scalability · §5.3 ↗"}]]}],["$","p",null,{"className":"study-scale","children":[["$","span",null,{"children":"Demonstrated in the paper"}],["$","strong",null,{"children":"791,283 valid generated samples"}],["$","span",null,{"children":"2,285 selected personas · 8 generators · 34 identity groups"}]]}],["$","figure",null,{"className":"paper-figure pipeline-figure","children":[["$","a",null,{"href":"/Persona-Hate/assets/pipeline.png","target":"_blank","rel":"noreferrer","aria-label":"Open full-size PersonaHate pipeline figure","children":["$","img",null,{"src":"/Persona-Hate/assets/pipeline.png","width":1270,"height":383,"alt":"Original PersonaHate pipeline: persona construction, diversity-aware selection, multi-LLM generation, multi-judge annotation, and balanced training set construction."}]}],["$","figcaption",null,{"children":[["$","strong",null,{"children":"Figure 1."}]," Overview of the PersonaHate pipeline."," ",["$","a",null,{"href":"/Persona-Hate/assets/personahate-paper.pdf#page=4","target":"_blank","rel":"noreferrer","children":"Paper, p. 4 ↗"}],["$","span",null,{"className":"figure-correction","children":"The original figure’s voting label should read “at least four of six votes,” following §4.4.2."}]]}]]}]]}]
