1b:["$","section",null,{"id":"coverage","children":[["$","h2",null,{"children":"Identity-group coverage"}],["$","p",null,{"children":"Generation spans 34 identity groups in six categories. These labels identify generation and evaluation targets; they do not describe the persona’s own identity."}],["$","$Ld",null,{"className":"paper-table coverage-table","children":[["$","$Le",null,{"children":["$","$Lf",null,{"children":[["$","$L10",null,{"scope":"col","children":"Category"}],["$","$L10",null,{"scope":"col","className":"number","children":"Groups"}],["$","$L10",null,{"scope":"col","children":"Identity groups"}]]}]}],["$","$L11",null,{"children":[["$","$Lf","Race / Ethnicity",{"children":[["$","$L10",null,{"scope":"row","className":"model-label","children":"Race / Ethnicity"}],["$","$L12",null,{"className":"number","children":7}],["$","$L12",null,{"children":"Asian; Black or African American; Latino or Non-White Hispanic; Middle Eastern; Native American or Alaska Native; Pacific Islander; Non-Hispanic White"}]]}],["$","$Lf","Religion",{"children":[["$","$L10",null,{"scope":"row","className":"model-label","children":"Religion"}],["$","$L12",null,{"className":"number","children":7}],["$","$L12",null,{"children":"Atheists; Buddhists; Christians; Hindus; Jews; Mormons; Muslims"}]]}],["$","$Lf","Immigration / Origin",{"children":[["$","$L10",null,{"scope":"row","className":"model-label","children":"Immigration / Origin"}],["$","$L12",null,{"className":"number","children":5}],["$","$L12",null,{"children":"Immigrants; Migrant Workers; People From a Specific Country; Undocumented People; Refugees"}]]}],["$","$Lf","Gender",{"children":[["$","$L10",null,{"scope":"row","className":"model-label","children":"Gender"}],["$","$L12",null,{"className":"number","children":6}],["$","$L12",null,{"children":"Men; Women; Non-Binary or Third Gender; Transgender Men; Transgender Women; Transgender (Unspecified)"}]]}],["$","$Lf","Sexual Orientation",{"children":[["$","$L10",null,{"scope":"ro