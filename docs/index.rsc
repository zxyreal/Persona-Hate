1c:["$","section",null,{"id":"scope","children":[["$","h2",null,{"children":"Scope and intended use"}],["$","p",null,{"children":"The artifact supports hate speech detector training and safety evaluation. The study covers English text and the identity groups listed above. Synthetic data complements human-authored benchmarks; aggregate improvements should not be interpreted as improvement for every dataset or group. See the paper’s limitations and ethical considerations for further context."}]]}]
